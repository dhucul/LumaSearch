<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\LumaSearch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LumaSearch</AssemblyName>
    <RootNamespace>LumaSearch</RootNamespace>
    <Version>1.5.6</Version>
    <Company>LumaSearch</Company>
    <Product>LumaSearch</Product>
    <Description>Fast, responsive file and folder search.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\LumaSearch.ico" />
    <Resource Include="Assets\LumaSearch.png" />
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>
</Project>
